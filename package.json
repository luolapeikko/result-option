{
	"name": "@luolapeikko/result-option",
	"version": "2.4.0",
	"description": "Rust style Result for TypeScript/Javascript",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		"import": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"require": {
			"types": "./dist/index.d.cts",
			"default": "./dist/index.cjs"
		},
		"default": "./dist/index.mjs"
	},
	"scripts": {
		"docs": "typedoc",
		"build": "tsdown src/index.mts --minify --sourcemap --format cjs,esm --dts --clean -c tsconfig.build.json",
		"prepublishOnly": "npm run build",
		"test": "vitest test --typecheck --run --no-isolate --coverage",
		"pretest": "npm run build",
		"coverage": "vitest test --typecheck --run --no-isolate --reporter=dot --coverage --coverage.reporter=lcov",
		"lint": "oxlint",
		"validate": "tsc --noEmit"
	},
	"files": [
		"dist"
	],
	"repository": "github:luolapeikko/result-option",
	"keywords": [
		"typescript",
		"result",
		"rust"
	],
	"author": "mharj",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^24.13.3",
		"@vitest/coverage-v8": "^4.1.10",
		"c8": "^11.0.0",
		"core-result": "^0.0.2",
		"oxlint": "^1.73.0",
		"oxlint-tsgolint": "^0.24.0",
		"prettier": "^3.9.5",
		"source-map-support": "^0.5.21",
		"tsdown": "^0.22.4",
		"typedoc": "^0.28.20",
		"@typescript/native": "npm:typescript@^7.0.2",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vite": "^8.1.4",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"core-result": "^0.0.2"
	},
	"packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e"
}
