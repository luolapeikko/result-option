{
	"name": "@luolapeikko/result-option",
	"version": "2.4.0",
	"description": "Rust style Result for TypeScript/Javascript",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		"import": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"require": {
			"types": "./dist/index.d.cts",
			"default": "./dist/index.cjs"
		},
		"default": "./dist/index.mjs"
	},
	"scripts": {
		"docs": "typedoc",
		"build": "tsdown src/index.mts --minify --sourcemap --format cjs,esm --dts --clean -c tsconfig.build.json",
		"prepublishOnly": "npm run build",
		"test": "vitest test --typecheck --run --no-isolate --coverage",
		"pretest": "npm run build",
		"lint": "oxlint",
		"validate": "tsc --noEmit"
	},
	"files": [
		"dist"
	],
	"repository": "github:luolapeikko/result-option",
	"keywords": [
		"typescript",
		"result",
		"rust"
	],
	"author": "mharj",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^24.19.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/coverage-v8": "^5.0.3",
		"c8": "^12.0.0",
		"core-result": "^0.0.3",
		"oxlint": "^1.86.0",
		"oxlint-tsgolint": "^7.0.2003",
		"prettier": "^3.9.9",
		"source-map-support": "^0.5.21",
		"tsdown": "^0.23.0",
		"typedoc": "^0.28.20",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vite": "^8.3.1",
		"vitest": "^5.0.3"
	},
	"peerDependencies": {
		"core-result": "^0.0.2"
	},
	"packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45"
}
